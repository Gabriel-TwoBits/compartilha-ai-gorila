# Brings the room back after Cloudflare WARP is switched off.
#
# A system service, not a user one: restarting tailscaled needs root, and this
# has to work whether or not anybody is logged in.
#
# Install:
#   sudo cp scripts/tailscale-after-warp.sh /usr/local/bin/
#   sudo chmod +x /usr/local/bin/tailscale-after-warp.sh
#   sudo cp scripts/tailscale-after-warp.service /etc/systemd/system/
#   sudo systemctl enable --now tailscale-after-warp

[Unit]
Description=Restart tailscaled when Cloudflare WARP goes away
# Only meaningful alongside the daemon it restarts.
After=tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tailscale-after-warp.sh

# `ip monitor` can be killed by a transient error, and a watcher that quietly
# stopped watching is worse than none: the room would go down and nobody would
# know why.
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
