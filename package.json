{
  "name": "compartilha-ai-gorila",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single room for sharing your screen and audio with friends, on Cloudflare Realtime SFU",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --env-file=.env server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file=.env server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.3",
    "partytracks": "^0.0.56",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.12",
    "webrtc-adapter": "^9.0.6",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
