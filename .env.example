# Port the Node server listens on. The Vite dev proxy forwards to it.
PORT=8787

# Realtime SFU credentials, created at
# https://dash.cloudflare.com/?to=/:account/realtime/sfu
# The token never reaches the browser: the server proxies /partytracks/*.
SFU_APP_ID=
SFU_APP_TOKEN=

# Cloudflare TURN credentials, created at
# https://dash.cloudflare.com/?to=/:account/realtime/turn/create
# Optional, and a separate product from the SFU app above. Without them the
# browser only gets STUN, which fails whenever there is no direct UDP path to
# the SFU — the peer connection ends in "ICE failed" and no video arrives.
# Set both or neither.
TURN_APP_ID=
TURN_APP_TOKEN=

# Single shared password everyone types to enter the room.
ROOM_PASSWORD=

# Signing key for the session cookie. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Rotating this key invalidates every existing session.
SESSION_SECRET=

# Whether the session cookie is marked Secure. Defaults to on when
# NODE_ENV=production. Set to false only to exercise a production build over
# plain http:// on localhost, where the browser would otherwise drop the cookie.
SECURE_COOKIES=
