# Where the room lives. Baked into the app at build time, because a packaged
# app cannot ask a friend to configure anything.
#
# Kept out of the repository: anybody holding the address lands on the login
# screen and the password is the gate, but this repository is public and there
# is no reason to publish where the room is.
GORILA_URL=https://your-machine.your-tailnet.ts.net
