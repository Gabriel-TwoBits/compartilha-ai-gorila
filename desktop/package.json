{
  "name": "compartilha-ai-gorila-desktop",
  "version": "0.2.3",
  "private": true,
  "description": "Desktop shell for CompartilhaAiGorila: its own screen picker, and per-application audio",
  "license": "AGPL-3.0-only",
  "main": "dist/main.cjs",
  "homepage": "https://codeberg.org/Gabriel-TwoBits/compartilha-ai-gorila",
  "author": "Gabriel-TwoBits",
  "desktopName": "compartilha-ai-gorila.desktop",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "smoke": "node smoke.mjs"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "loopback-capture": "^3.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
